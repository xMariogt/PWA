{
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "emprendimiento",
            "installMode": "prefetch",
            "resources": {
                "files": [
                    "/favicon.ico",
                    "/index.html",
                    "/*.css",
                    "/*.js"
                ]
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/assets/**",
                    "/*.(png|jpg|jpeg|svg)"
                ]
            }
        }
    ]
}